  "keywords": ["pull-request", "code-review", "review", "diff", "claude-code", "skill", "agent"],
  "license": "MIT",
  "author": "HelixMorphe",
  "homepage": "https://github.com/HelixMorphe/whats-this-pr#readme",
  "repository": { "type": "git", "url": "git+https://github.com/HelixMorphe/whats-this-pr.git", "directory": "packages/cli" },
  "bugs": "https://github.com/HelixMorphe/whats-this-pr/issues",
  "type": "module",
  "bin": { "whats-this-pr": "bin/whats-this-pr.mjs" },
  "exports": {
    ".": "./lib/index.mjs",
    "./diff": "./lib/diff.mjs",
    "./template.html": "./template.html",
    "./package.json": "./package.json"
  },
  "files": ["bin", "lib", "template.html", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=20" },
